# Copy to web/.env.local. Never commit real keys.
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used only by the explicit seed script, never by normal API requests.
SUPABASE_SERVICE_ROLE_KEY=
# Optional extension target; localhost is the development default.
WEB_APP_URL=http://localhost:3000
# Required only when seeding demo users; choose a private demo password.
DEMO_TEACHER_PASSWORD=
