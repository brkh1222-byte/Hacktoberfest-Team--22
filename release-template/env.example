# Homework plugin API configuration. Use the same Redis and MongoDB as your
# erxes gateway and core-api.

# Same Redis erxes uses: the plugin registers itself with the gateway here.
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# Same MongoDB erxes uses. Plugin data lives in homework_* collections of each
# organization's database.
MONGO_URL=mongodb://mongo:27017/erxes

# Browser-reachable URL of ui/remoteEntry.js on your static host or CDN.
UI_ENTRY_URL=https://cdn.example.com/homework_ui/remoteEntry.js

# Address the gateway uses to reach this API. Unset = plugin-homework-api.
# LOAD_BALANCER_ADDRESS=http://plugin-homework-api:80

# Required to enable teacher-owned provider keys. Generate a private value with
# openssl rand -base64 32, keep it secret, and back it up separately.
HOMEWORK_API_KEY_SECRET=

# Set to saas on erxes SaaS (one database per organization).
# VERSION=os
