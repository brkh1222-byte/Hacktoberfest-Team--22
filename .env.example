NODE_ENV=development
# Overrides api.port from erxes.json.
# PORT=
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Required by the platform stack (tenant-scoped Mongoose models).
# MONGO_URL=mongodb://localhost:27017/erxes
# Where the browser loads the UI remote from. Unset = plugins.erxes.io/<release>/homework_ui/.
UI_ENTRY_URL=http://localhost:3099/remoteEntry.js
# Address the gateway uses to reach this API. Unset = localhost (dev) or plugin-homework-api (prod).
# LOAD_BALANCER_ADDRESS=
# Release folder on plugins.erxes.io when it starts with "3."; otherwise "latest".
# RELEASE_VERSION=
# Optional AI provider. Without a key, generation returns a clearly flagged sample.
# ANTHROPIC_API_KEY=
# HOMEWORK_AI_MODEL=claude-sonnet-5-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Only needed when both keys are set: anthropic | gemini
# HOMEWORK_AI_PROVIDER=
